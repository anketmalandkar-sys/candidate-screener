# ---------------------------------------------------------------------------
# Copy to .env and fill in.  .env is gitignored and must never be committed.
#
#   cp .env.example .env
#   openssl rand -hex 32      # paste the output as APP_SECRET_KEY
# ---------------------------------------------------------------------------

# Postgres — the DB and user are created automatically on first container start
POSTGRES_DB=candidate_screener
POSTGRES_USER=screener
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5432

# Host port the API is exposed on
BACKEND_PORT=8000

# HS256 secret used to sign session JWTs.
# The app REFUSES TO START if this is unset, empty, or still this placeholder.
APP_SECRET_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32

# Session lifetime
ACCESS_TOKEN_EXPIRE_HOURS=8

# Public origin for the deploy stack (docker-compose.deploy.yml only).
# Leave blank for local/dev or when a tunnel terminates TLS (Tailscale Funnel).
# Set to https://<host> on a cloud VM and Caddy fetches its own cert, e.g.
# https://34-28-1-2.sslip.io  (sslip.io resolves the dashed IP -> no domain needed).
SITE_ADDRESS=

# Set true when serving over HTTPS so the session cookie carries the Secure flag
COOKIE_SECURE=false

# Comma-separated extra CORS origins (LAN IPs, staging URLs).
# On a cloud VM set this to the same value as SITE_ADDRESS.
EXTRA_ORIGINS=

# Number of trusted reverse proxies in front of the app.
# 0 for direct/local; 1 when behind nginx or a load balancer.
# Controls how far back we trust X-Forwarded-For when rate limiting by IP.
TRUSTED_PROXY_COUNT=0

# When true, every new registration is given its own private copy of a large
# synthetic dataset (~6 roles, 120+ candidates), so every recruiter sees seed
# data. Existing accounts: `docker compose exec backend python -m app.seed`.
SEED_DEMO_DATA=true

# ---------------------------------------------------------------------------
# Screening (multi-agent resume integrity checks)
# ---------------------------------------------------------------------------
# `live` (default): use the detection + synthesis backends below; falls back to
# the deterministic pipeline if a backend can't be built (e.g. no keys).
# `stub`: deterministic pre-scan only, no network. Tests always run as `stub`.
SCREENING_PROVIDER=live
# Detection tier (Agents 1/2/3):
#   openai_agentic (default) — 1/2/3 are tool-using agents on OPENAI_SUBAGENT_MODEL
#   hf_inference — 1/2/3 on an opt-in HF-routed chat model, else deterministic pre-scan
#   hf_local | stub
SCREENING_DETECTION_BACKEND=openai_agentic
# Synthesis tier (Agents 4/5): openai | stub
SCREENING_SYNTHESIS_BACKEND=openai
SCREENING_CONCURRENCY=4
# Log every model request + response at INFO (verbose, includes resume text).
# On by default; set to false to quiet it. The request/response pair is always
# saved to screening_agent_runs and served over the API regardless.
SCREENING_LOG_PROMPTS=true

# Hugging Face Inference — the prompt-injection classifier (an hf-inference task
# model) runs per candidate on every detection backend; raw resume text stays on
# HF for that call.
HF_TOKEN=
# HF_BILL_TO=my-org
# HF_SUBAGENT_MAX_TOOL_STEPS=4          # tool-call rounds per sub-agent before it must answer
#
# Only for SCREENING_DETECTION_BACKEND=hf_inference: route sub-agents 1-3 through
# an HF-routed chat model instead of OpenAI (résumé text then goes to that
# provider; needs HF Inference-Providers credits). Unset => hf_inference means
# deterministic pre-scan for 1-3.
# HF_SUBAGENT_CHAT_MODEL=meta-llama/Llama-3.1-8B-Instruct
# HF_SUBAGENT_CHAT_PROVIDER=            # blank = "auto" routing; or pin: together, nebius, novita, ...

# OpenAI — or ANY OpenAI-compatible chat-completions endpoint (Ollama, vLLM,
# LM Studio, Groq, OpenRouter, together.ai, Azure OpenAI, llama.cpp, …). Used by
# the synthesis tier (Agents 4/5) and, by default, detection sub-agents 1-3.
# Résumé text and evidence quotes reach this endpoint (both full profiles for
# Agent 5). To change the model, point *_BASE_URL at your server and set the
# model names below — no code change.
OPENAI_API_KEY=
OPENAI_SYNTHESIS_MODEL=gpt-4.1
OPENAI_SUBAGENT_MODEL=gpt-4.1-mini    # detection Agents 1-3 (openai_agentic backend)
OPENAI_BASE_URL=                      # blank = https://api.openai.com/v1; e.g. http://host.docker.internal:11434/v1 for Ollama
#
# Per-tier overrides — each falls back to the OPENAI_* values above; blank = unset.
# Lets you split e.g. detection on an open model + synthesis on hosted OpenAI.
# SCREENING_DETECTION_BASE_URL=
# SCREENING_DETECTION_API_KEY=
# SCREENING_SYNTHESIS_BASE_URL=
# SCREENING_SYNTHESIS_API_KEY=
#
# Example — detection Agents 1-3 on Llama-3.1-8B via the HF Inference Providers
# router, synthesis Agents 4-5 left on hosted OpenAI (don't set OPENAI_BASE_URL):
# SCREENING_DETECTION_BASE_URL=https://router.huggingface.co/v1
# SCREENING_DETECTION_API_KEY=hf_...
# OPENAI_SUBAGENT_MODEL=meta-llama/Llama-3.1-8B-Instruct
#
# Ready-to-paste HF router / Ollama / vLLM / Azure / Groq configs: docs/llm-backends.md

